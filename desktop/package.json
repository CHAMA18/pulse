{
  "name": "pulse-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Pulse — Pharmacy Portal desktop application",
  "main": "main.cjs",
  "author": "Pulse",
  "license": "UNLICENSED",
  "scripts": {
    "dist:mac": "electron-builder --mac dmg zip --universal --publish never",
    "dist:win": "electron-builder --win portable zip --x64 --publish never"
  },
  "devDependencies": {
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "africa.pulse.desktop",
    "productName": "Pulse",
    "copyright": "Copyright © 2026 Pulse",
    "electronVersion": "45.2.1",
    "asar": true,
    "afterPack": "after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "app/**/*"
    ],
    "mac": {
      "category": "public.app-category.medical",
      "identity": "Developer ID Application",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": true,
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ]
    },
    "dmg": {
      "title": "Pulse ${version}",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    },
    "artifactName": "Pulse-${version}-${os}-${arch}.${ext}"
  }
}
